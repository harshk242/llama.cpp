#version 450

#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#if USE_SUBGROUP_ADD || USE_SUBGROUP_ADD_NO_SHMEM
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_KHR_shader_subgroup_ballot : require
#define SHUFFLE_SCALES 1
// value of thread c of the 16-thread group. On Intel Xe a broadcast from a constant lane is much cheaper than a shuffle.
#define GROUP_LANE(v, c) (gl_SubgroupSize == 16 ? subgroupBroadcast(v, c) : subgroupShuffle(v, (gl_SubgroupInvocationID & ~15u) + c))
#endif

#include "mul_mat_vec_base.glsl"

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

// A q6_K block is 105 16-bit words: ql[64], qh[32], scales[8], d.
// 16 threads share a block. For each 128-value half h, thread t reads ql words 32h+t and 32h+16+t
// and qh word 16h+t, so the loads of the 16 threads are contiguous.
// The scales and d are read once per block by threads 0..8 and shared through the subgroup:
// a load of the same scale word by all threads is much slower on Intel Xe.
layout (binding = 0) readonly buffer A_U16 {uint16_t data_a_u16[];};
layout (binding = 0) readonly buffer A_F16 {float16_t data_a_f16[];};

#define WORDS_PER_BLOCK 105
#define QH_WORD 64
#define SCALES_WORD 96
#define D_WORD 104

FLOAT_TYPE temp[NUM_COLS][NUM_ROWS];

void calc_block(const uint ib, const uint itid, const uint row_w0, const uint nw_row, const uint b_offset, const uint num_rows) {
    const uint is = itid / 8;
    const uint y_idx = ib * QUANT_K + 2 * itid;

    vec2 by[NUM_COLS][8];
    [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
        [[unroll]] for (uint m = 0; m < 8; ++m) {
            by[j][m] = vec2(data_b_v2[(j * p.batch_stride_b + b_offset + y_idx + 32 * m) / 2]);
        }
    }

    [[unroll]] for (uint n = 0; n < num_rows; ++n) {
        const uint bw = row_w0 + n * nw_row + ib * WORDS_PER_BLOCK;

#ifdef SHUFFLE_SCALES
        const uint sd_word = uint(data_a_u16[bw + SCALES_WORD + min(itid, 8)]);
        const uint sc_words[8] = {GROUP_LANE(sd_word, 0), GROUP_LANE(sd_word, 1), GROUP_LANE(sd_word, 2), GROUP_LANE(sd_word, 3),
                                  GROUP_LANE(sd_word, 4), GROUP_LANE(sd_word, 5), GROUP_LANE(sd_word, 6), GROUP_LANE(sd_word, 7)};
        const FLOAT_TYPE d = FLOAT_TYPE(unpackHalf2x16(GROUP_LANE(sd_word, 8)).x);
#else
        const FLOAT_TYPE d = FLOAT_TYPE(data_a_f16[bw + D_WORD]);
#endif

        [[unroll]] for (uint h = 0; h < 2; ++h) {
            const uint32_t ql = uint32_t(data_a_u16[bw + 32 * h + itid]) | (uint32_t(data_a_u16[bw + 32 * h + 16 + itid]) << 16);
            const uint32_t qh = uint32_t(data_a_u16[bw + QH_WORD + 16 * h + itid]) * 0x00010001u;

            // bytes: values l, l+1 (low nibble of ql) and l+32, l+33 (low nibble of ql+32), then the same + 64 for the high nibbles
            const uint32_t q_lo = (ql & 0x0F0F0F0F) | ((qh & 0x00000303) << 4) | ((qh & 0x0C0C0000) << 2);
            const uint32_t q_hi = ((ql >> 4) & 0x0F0F0F0F) | (qh & 0x00003030) | ((qh & 0xC0C00000) >> 2);
            const vec4 v_lo = vec4(unpack8(q_lo)) - 32;
            const vec4 v_hi = vec4(unpack8(q_hi)) - 32;

            uint sc_word[4];
            [[unroll]] for (uint m = 0; m < 4; ++m) {
#ifdef SHUFFLE_SCALES
                sc_word[m] = sc_words[4 * h + m];
#else
                sc_word[m] = uint(data_a_u16[bw + SCALES_WORD + 4 * h + m]);
#endif
            }
            const vec4 sc = vec4(
                bitfieldExtract(int(sc_word[0]), int(8 * is), 8),
                bitfieldExtract(int(sc_word[1]), int(8 * is), 8),
                bitfieldExtract(int(sc_word[2]), int(8 * is), 8),
                bitfieldExtract(int(sc_word[3]), int(8 * is), 8));

            [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
                const vec4 s = vec4(dot(v_lo.xy, by[j][4 * h]), dot(v_lo.zw, by[j][4 * h + 1]), dot(v_hi.xy, by[j][4 * h + 2]), dot(v_hi.zw, by[j][4 * h + 3]));
                temp[j][n] = fma(d, FLOAT_TYPE(dot(s, sc)), temp[j][n]);
            }
        }
    }
}

void compute_outputs(const uint first_row, const uint num_rows) {
    uint a_offset, b_offset, d_offset;
    get_offsets(a_offset, b_offset, d_offset);

    const uint num_blocks_per_row = p.ncols / QUANT_K;
    const uint nw_row = num_blocks_per_row * WORDS_PER_BLOCK;
    const uint row_w0 = (a_offset + first_row * num_blocks_per_row) * WORDS_PER_BLOCK;

    const uint tid = gl_LocalInvocationID.x;
    const uint itid = tid % 16;
    const uint ix = tid / 16;
    const uint it_size = gl_WorkGroupSize.x / 16;

    [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
        [[unroll]] for (uint i = 0; i < NUM_ROWS; ++i) {
            temp[j][i] = FLOAT_TYPE(0);
        }
    }

    for (uint ib = ix; ib < num_blocks_per_row; ib += it_size) {
        calc_block(ib, itid, row_w0, nw_row, b_offset, num_rows);
    }

    reduce_result(temp, d_offset, first_row, num_rows, tid);
}

void main() {
    const uint first_row = NUM_ROWS * (gl_WorkGroupID.x + gl_NumWorkGroups.x * gl_WorkGroupID.z);

    // do NUM_ROWS at a time, unless there aren't enough remaining rows
    if (first_row + NUM_ROWS <= p.stride_d) {
        compute_outputs(first_row, NUM_ROWS);
    } else {
        if (first_row >= p.stride_d) {
            return;
        }
        compute_outputs(first_row, p.stride_d - first_row);
    }
}
